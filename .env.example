# Copy this to .env and fill in your values.

# PostgreSQL/NeonDB connection string.
# Leave unset to use SQLite (pipeline.db in repo root).
# DATABASE_URL=postgresql://user:password@ep-xxx.aws.neon.tech/dbname?sslmode=require

# PII salt: must be stable across runs for phone hashes to match.
# Change this to a strong random value in production.
# PII_SALT=change-me-to-something-secret

